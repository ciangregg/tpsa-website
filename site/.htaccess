# The Problem Solving site is served from a directory rather than a flat .html
# file — the first page on this site that is. Name its index explicitly instead
# of relying on the host's DirectoryIndex default.
DirectoryIndex index.html

# That site's scripts are ES modules, which browsers refuse to execute unless
# the Content-Type is a JavaScript type — a wrong type blocks the whole module
# graph rather than one file. State the types it depends on.
AddType text/javascript .js
AddType image/svg+xml .svg

RewriteEngine On

# The Problem Solving Association site lives in the problem-solving/ directory.
# Send the retired single-page version and every spelling of the path to it.
RewriteRule ^problem-solving/index\.html$ /problem-solving/ [R=301,L]
RewriteRule ^problem-solving\.html$ /problem-solving/ [R=301,L]
RewriteRule ^problem-solving$ /problem-solving/ [R=301,L]
RewriteRule ^problemsolving$ /problem-solving/ [R=301,L]

# Redirect project to calendar
RewriteRule ^projects$ /calendar [R=301,L]

# Redirect homepage to student
RewriteRule ^homepage$ /student [R=301,L]

#Redirect internship to internships
RewriteRule ^internship$ /internships [R=301,L]

# Redirects for sign up
RewriteRule ^signup$ /sign-up [R=301,L]
RewriteRule ^sign-ups$ /sign-up [R=301,L]
RewriteRule ^signups$ /sign-up [R=301,L]

# Redirect both hackathon/s and workshop/s to hackathons
RewriteRule ^hackathon$ /hackathons [R=301,L]
RewriteRule ^workshop$ /hackathons [R=301,L]
RewriteRule ^workshops$ /hackathons [R=301,L]


RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^.]+)$ $1.html [L]
RewriteCond %{THE_REQUEST} /([^.]+)\.html [NC]
RewriteRule ^ /%1? [NC,L,R=301]
